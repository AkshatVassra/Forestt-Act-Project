# Database Configuration
DB_BACKEND=postgres
POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pdf_pipeline
# MONGO_URL=mongodb://localhost:27017/
# MONGO_DB_NAME=pdf_pipeline

# Tesseract Configuration
# Path to tesseract binary (optional, auto-detected if in PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# Custom Tesseract Model Configuration
# Path to your trained .traineddata file relative to backend directory
# Examples:
# CUSTOM_TESSERACT_MODEL=models/custom_forest.traineddata
# CUSTOM_TESSERACT_MODEL=models/custom_hindi.traineddata
# CUSTOM_TESSERACT_MODEL=models/custom_multilingual.traineddata
CUSTOM_TESSERACT_MODEL=

# OCR Processing Settings
# DPI for PDF rendering (higher = better quality but slower)
PDF_DPI=300

# Image upscaling factor before OCR (2.0 = 2x upscaling)
OCR_UPSCALE_FACTOR=2.0

# spaCy NER Model
SPACY_MODEL=en_core_web_sm

# File Upload Settings
MAX_UPLOAD_SIZE_MB=20
